
{
  "appId": "com.valtrixcap.app",
  "appName": "ValtrixCap",
  "webDir": "www",
  "server": {
    "url": "https://valtrixcap.com",
    "cleartext": false,
    "allowNavigation": [
      "valtrixcap.com",
      "*.valtrixcap.com"
    ]
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 2500,
      "launchAutoHide": true,
      "launchFadeOutDuration": 500,
      "backgroundColor": "#06143D",
      "showSpinner": false
    }
  }
}
